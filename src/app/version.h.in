// Version header, generated by CMake from src/app/version.h.in.
//
// The version is defined once, in CMakeLists.txt (project(... VERSION x.y.z)),
// and this template is expanded by configure_file() into the build tree. Both
// the C++ code and the Windows resource script (VERSIONINFO in
// assets/white_sound.rc) include the generated copy, so the "About" dialog, the
// executable's file properties and the installer all report the same number.
//
// Do not edit the generated copy in the build tree; edit this template or the
// version in CMakeLists.txt instead.

#pragma once

#define WS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define WS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define WS_VERSION_PATCH @PROJECT_VERSION_PATCH@

// Human-readable version, e.g. "1.0.0".
#define WS_VERSION_STRING "@PROJECT_VERSION@"

// Wide variant for Win32 APIs that take LPCWSTR.
#define WS_VERSION_STRING_W L"@PROJECT_VERSION@"

// Comma-separated numeric form for VERSIONINFO's FILEVERSION/PRODUCTVERSION.
#define WS_VERSION_COMMA @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0

// Strings shared by the executable metadata and the About dialog.
#define WS_PRODUCT_NAME       "White Sound"
#define WS_FILE_DESCRIPTION   "White Sound - Bluetooth Keep Alive"
#define WS_COPYRIGHT          "MIT License. Copyright (c) 2026 White Sound Project"
#define WS_ORIGINAL_FILENAME  "white_sound_tray.exe"
